# Thông tin đăng nhập No-IP.com
NOIP_USERNAME=your_email_or_username
NOIP_PASSWORD=your_noip_password
NOIP_2FA_SECRET_KEY=YOUR16CHAR2FAKEY

# Mức độ debug (1 = bình thường, 2 = chụp ảnh từng bước)
NOIP_DEBUG=2

# Cấu hình nhận thông báo kèm ảnh kết quả qua Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCDEF...
TELEGRAM_CHAT_ID=1900957785
